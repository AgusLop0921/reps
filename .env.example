# Supabase — cross-device progress sync (ADR-0020). Copy to `.env` and fill in.
# Both are safe to expose in the frontend: the anon key is public and only works with
# Row-Level Security on. The service-role key is NEVER put here or in the client.
# Leave these unset and the app runs local-only, exactly as before — sync just stays off.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
